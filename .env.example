# Copiar a .env y completar. El .env real nunca se versiona.

# Supabase del producto (fiat: spieokzbbwmgkcdigsxo)
EXPO_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# test | production
EXPO_PUBLIC_APP_ENV=test

# Push. Sin esto la app arranca igual, solo no registra el dispositivo.
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# ⚠️ ZapSign: NO agregar la API key acá.
# Todo lo que empieza con EXPO_PUBLIC_ queda incrustado en el binario y se
# puede extraer del APK. La clave del proveedor de KYC tiene que vivir del
# lado del servidor. Ver docs/pendientes.md.
